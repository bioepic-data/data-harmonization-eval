{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash"
    ],
    "deny": [
      "Bash(dangerouslyDisableSandbox:true)",
      "Read(../**)",
      "Read(**/../**)",
      "Edit(../**)",
      "Edit(**/../**)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "/"
      ],
      "denyWrite": [
        "/"
      ],
      "allowRead": [
        "."
      ],
      "allowWrite": [
        "."
      ]
    },
    "network": {
      "allowedDomains": []
    }
  }
}
