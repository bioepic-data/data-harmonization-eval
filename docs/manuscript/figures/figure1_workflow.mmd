%% Figure 1. Current leave-one-cluster-out evaluation workflow.
%% Render in browser via figure1_workflow.html, or paste into https://mermaid.live
flowchart TB
    classDef prep fill:#e9f3f5,stroke:#0e7180,color:#23303a,stroke-width:1.5px;
    classDef gold fill:#f8efd9,stroke:#c9962f,color:#23303a,stroke-width:1.5px;
    classDef agent fill:#0e7c7b,stroke:#0a5a59,color:#ffffff,stroke-width:1.5px;
    classDef audit fill:#eef4df,stroke:#7ba527,color:#23303a,stroke-width:1.5px;
    classDef score fill:#3b5b8c,stroke:#28406a,color:#ffffff,stroke-width:1.5px;
    classDef io fill:#ffffff,stroke:#8a8a8a,color:#23303a,stroke-dasharray:3 3;

    GOLD["Expert gold corpus<br/>mapping JSON + dataset_NN.py"]:::gold
    SKILLS["Curator + harmonizer<br/>skills"]:::prep
    FOLD["Resolve target fold<br/>hold out whole source/instrument cluster"]:::prep
    BUILD["Build answer-free workspace<br/>filtered mapping + held-out-free expert modules"]:::prep
    RAW["Stage target raw inputs<br/>ESS-DIVE files + target package metadata"]:::io

    GOLD --> FOLD
    SKILLS --> BUILD
    FOLD --> BUILD
    FOLD --> RAW
    BUILD --> RUN
    RAW --> RUN

    subgraph ISO["Isolated agent workspace"]
        direction TB
        RUN["AGENT_INSTRUCTIONS.md + MANIFEST.json<br/>no held-out gold · no parent dirs · no network"]:::prep
        AGENT["LLM agent uses curator/harmonizer skills"]:::agent
        OUT["output/<br/>harmonized CSV · location CSV · transform code<br/>change-mapping JSON · notes"]:::gold
        RUN --> AGENT --> OUT
    end

    OUT --> AUDIT["Invigilator audit<br/>tool trace checked for out-of-bounds access"]:::audit
    AUDIT --> ARCHIVE["eval/* orphan branch<br/>+ complete workflow artifact"]:::audit
    OUT --> SCORE["Trusted post-run scoring<br/>agent outputs vs expert BERDL reference"]:::score
    SCORE --> DIAG["Metrics + diagnostics<br/>row equivalence · cell agreement · locations · mappings"]:::score
